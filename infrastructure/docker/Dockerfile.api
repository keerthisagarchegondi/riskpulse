# syntax=docker/dockerfile:1.7

ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        librdkafka-dev \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install \
        asyncpg \
        boto3 \
        confluent-kafka \
        cryptography \
        fastapi \
        numpy \
        passlib[bcrypt] \
        pydantic \
        pydantic-settings \
        python-jose[cryptography] \
        pyyaml \
        redis \
        sqlalchemy[asyncio] \
        structlog \
        tenacity \
        uvicorn[standard]

FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RISKPULSE_ENV=prod \
    RISKPULSE_SERVICE=api \
    UVICORN_WORKERS=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        librdkafka1 \
        libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system riskpulse \
    && useradd --system --gid riskpulse --home-dir /app --shell /usr/sbin/nologin riskpulse

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY src/ ./src/
COPY config/ ./config/
COPY schemas/ ./schemas/
COPY scripts/container_healthcheck.py ./scripts/container_healthcheck.py
COPY scripts/verify_runtime_security.py ./scripts/verify_runtime_security.py

RUN chown -R riskpulse:riskpulse /app

USER riskpulse

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python scripts/container_healthcheck.py api

CMD ["sh", "-c", "uvicorn src.api.app:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS} --proxy-headers"]
