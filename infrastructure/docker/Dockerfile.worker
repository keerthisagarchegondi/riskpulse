# syntax=docker/dockerfile:1.7

ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        librdkafka-dev \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install \
        asyncpg \
        boto3 \
        confluent-kafka \
        cryptography \
        numpy \
        pandas \
        psycopg2-binary \
        pyarrow \
        pydantic \
        pyyaml \
        redis \
        scikit-learn \
        snowflake-connector-python \
        sqlalchemy[asyncio] \
        structlog \
        tenacity

FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RISKPULSE_ENV=prod \
    RISKPULSE_SERVICE=worker \
    RISKPULSE_KAFKA_HOST=kafka \
    RISKPULSE_KAFKA_PORT=29092

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        librdkafka1 \
        libgomp1 \
        libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system riskpulse \
    && useradd --system --gid riskpulse --home-dir /app --shell /usr/sbin/nologin riskpulse

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY src/ ./src/
COPY config/ ./config/
COPY schemas/ ./schemas/
COPY scripts/container_healthcheck.py ./scripts/container_healthcheck.py

RUN chown -R riskpulse:riskpulse /app

USER riskpulse

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python scripts/container_healthcheck.py worker

CMD ["python", "-m", "src.ingestion.kafka_consumer"]
