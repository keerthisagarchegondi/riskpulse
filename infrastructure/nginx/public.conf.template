limit_req_zone $binary_remote_addr zone=riskpulse_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=riskpulse_dashboard:10m rate=10r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080 default_server;
    return 444;
}

server {
    listen 8080;
    server_name ${RISKPULSE_API_DOMAIN};
    return 301 https://${RISKPULSE_API_DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name ${RISKPULSE_DASHBOARD_DOMAIN};
    return 301 https://${RISKPULSE_DASHBOARD_DOMAIN}$request_uri;
}

server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    server_name ${RISKPULSE_API_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    limit_req_status 429;

    location / {
        limit_req zone=riskpulse_api burst=40 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 8443 ssl;
    server_name ${RISKPULSE_DASHBOARD_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    limit_req_status 429;
    auth_basic "RiskPulse dashboard";
    auth_basic_user_file /etc/nginx/.riskpulse-htpasswd;

    location / {
        limit_req zone=riskpulse_dashboard burst=20 nodelay;
        proxy_pass http://streamlit:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization "";
        proxy_read_timeout 3600s;
    }
}
