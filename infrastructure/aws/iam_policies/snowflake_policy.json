{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeExternalStageRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::riskpulse-*-raw",
        "arn:aws:s3:::riskpulse-*-raw/transactions/*",
        "arn:aws:s3:::riskpulse-*-processed",
        "arn:aws:s3:::riskpulse-*-processed/reporting/*"
      ]
    },
    {
      "Sid": "SnowflakeExternalStageWrite",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::riskpulse-*-processed/snowflake/*"
      ]
    },
    {
      "Sid": "DecryptStageObjects",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:*:*:key/*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "s3.*.amazonaws.com"
        }
      }
    }
  ]
}
