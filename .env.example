# =============================================================================
# RiskPulse - Fraud Analytics & Risk Intelligence Platform
# Local Environment Configuration
# =============================================================================
#
# Copy this file to .env for local development. Replace every production secret
# with values from AWS Secrets Manager, GitHub secrets, or your deployment
# platform. Do not commit a populated .env file.

# Application
RISKPULSE_ENV=dev
RISKPULSE_SERVICE=api
RISKPULSE_INSTANCE_ID=local

# API
RISKPULSE_API_HOST=0.0.0.0
RISKPULSE_API_PORT=8000
RISKPULSE_API_KEY=dev-api-key-change-in-production
RISKPULSE_BEARER_TOKEN=
RISKPULSE_JWT_SECRET=dev-jwt-secret-change-in-production
RISKPULSE_ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key

# PostgreSQL - application settings
RISKPULSE_DB_HOST=localhost
RISKPULSE_DB_PORT=5432
RISKPULSE_DB_NAME=riskpulse
RISKPULSE_DB_USER=riskpulse
RISKPULSE_DB_PASSWORD=riskpulse_dev_password
RISKPULSE_DATABASE__POOL_SIZE=20

# PostgreSQL - script aliases used by backup and migration scripts
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=riskpulse
POSTGRES_USER=riskpulse
POSTGRES_PASSWORD=riskpulse_dev_password

# Kafka
RISKPULSE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RISKPULSE_KAFKA_HOST=localhost
RISKPULSE_KAFKA_PORT=9092
KAFKA_CONSUMER_GROUP=riskpulse-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Redis
RISKPULSE_REDIS_HOST=localhost
RISKPULSE_REDIS_PORT=6379
RISKPULSE_REDIS_DB=0
REDIS_PASSWORD=

# Snowflake
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_DATABASE=RISKPULSE
SNOWFLAKE_WAREHOUSE=RISKPULSE_WH
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=RISKPULSE_ROLE

# AWS
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_RAW=riskpulse-dev-raw
AWS_S3_BUCKET_PROCESSED=riskpulse-dev-processed
AWS_S3_BUCKET_MODELS=riskpulse-dev-models

# AWS Secrets Manager
RISKPULSE_SECURITY__SECRETS_MANAGER__ENABLED=false
RISKPULSE_DATABASE_SECRET_ID=
RISKPULSE_API_KEYS_SECRET_ID=
RISKPULSE_JWT_SECRET_ID=

# CloudWatch
RISKPULSE_MONITORING__CLOUDWATCH__ENABLED=false
CLOUDWATCH_LOG_GROUP=/riskpulse/dev
CLOUDWATCH_METRICS_NAMESPACE=RiskPulse/Dev

# Docker images and service ports
RISKPULSE_IMAGE_REGISTRY=riskpulse
RISKPULSE_IMAGE_TAG=latest
RISKPULSE_STREAMLIT_PORT=8501
RISKPULSE_AIRFLOW_PORT=8080

# Deployment verification
RISKPULSE_BASE_URL=http://127.0.0.1:8000
RISKPULSE_STREAMLIT_URL=http://127.0.0.1:8501
RISKPULSE_DASHBOARD_BASE_URL=http://127.0.0.1:8501
RISKPULSE_AIRFLOW_URL=http://127.0.0.1:8080
RUN_AWS_CHECKS=false

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=change-me-generate-with-python
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-production

# Model Configuration
MODEL_VERSION=v1.0.0
MODEL_ANOMALY_CONTAMINATION=0.01
MODEL_RISK_THRESHOLD_HIGH=0.8
MODEL_RISK_THRESHOLD_CRITICAL=0.95

# Alerting and notification channels
RISKPULSE_SLACK_WEBHOOK_URL=
RISKPULSE_TEAMS_WEBHOOK_URL=
RISKPULSE_PAGERDUTY_ROUTING_KEY=
RISKPULSE_SIEM_WEBHOOK_URL=
RISKPULSE_SIEM_API_KEY=
ALERT_EMAIL_SENDER=alerts@riskpulse.dev
ALERT_ESCALATION_TIMEOUT_MINUTES=15
